# ---------------------------------------------------------------------------
# KoopKITA environment variables
# Copy to .env.local for local development. NEVER commit real values.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings → API). Browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (sb_publishable_...) or legacy anon key. Browser-safe:
# all data access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public base URL of the app — used in email verification / password reset links.
NEXT_PUBLIC_SITE_URL=https://koopkita.example.com

# ---------------------------------------------------------------------------
# Server-only secrets. The web app does NOT need these at runtime.
# Only scripts/provision-super-admin.mjs uses them, from a trusted machine.
# Do NOT add them to Vercel and never prefix them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPER_ADMIN_PASSWORD=
